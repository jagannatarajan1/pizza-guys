generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(uuid())
  name                String    @default("")
  email               String    @unique
  phone               String    @default("")
  passwordHash        String    @map("password_hash")
  role                String    @default("user")
  // 2FA
  twoFactorSecret     String?   @map("two_factor_secret")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorBackup     String    @default("[]") @map("two_factor_backup")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  failedLogins        Int       @default(0) @map("failed_logins")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  addresses           Address[]
  orders              Order[]

  @@map("users")
}

model PendingRegistration {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String   @map("password_hash")
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String   @default("Home")
  line1     String   @default("")
  line2     String   @default("")
  city      String   @default("")
  postcode  String   @default("")
  notes     String   @default("")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  userId          String?     @map("user_id")
  status          String      @default("pending")
  orderType       String      @map("order_type")
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  customerPhone   String      @map("customer_phone")
  deliveryAddress String?     @map("delivery_address")
  subtotal        Int
  deliveryFee     Int         @default(0) @map("delivery_fee")
  discount        Int         @default(0)
  total           Int
  paymentIntentId String?     @map("payment_intent_id")
  paymentMethod   String      @default("card") @map("payment_method")
  scheduledTime   DateTime?   @map("scheduled_time")
  createdAt       DateTime    @default(now()) @map("created_at")
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@map("orders")
}

model Category {
  id      String  @id
  name    String
  slug    String  @unique
  icon    String  @default("🍽️")
  visible Boolean @default(true)
  order   Int     @default(0)

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  price       Int
  image       String   @default("")
  category    String
  popular     Boolean  @default(false)
  available   Boolean  @default(true)
  modifiers   String   @default("[]")
  allergens   String   @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt       @map("updated_at")

  @@map("products")
}

model SiteConfig {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

model DeliveryZone {
  id          String  @id @default(uuid())
  postcode    String  @unique
  minOrder    Int     @default(1000) @map("min_order")
  deliveryFee Int     @default(199)  @map("delivery_fee")
  enabled     Boolean @default(true)

  @@map("delivery_zones")
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String
  value       Int       @default(0)
  minOrder    Int       @default(0)  @map("min_order")
  description String    @default("")
  active      Boolean   @default(true)
  usageLimit  Int?      @map("usage_limit")
  usageCount  Int       @default(0)  @map("usage_count")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model ModifierGroup {
  id          String           @id @default(uuid())
  name        String
  required    Boolean          @default(false)
  multiSelect Boolean          @default(false) @map("multi_select")
  min         Int              @default(0)
  max         Int              @default(1)
  sortOrder   Int              @default(0)    @map("sort_order")
  options     ModifierOption[]

  @@map("modifier_groups")
}

model ModifierOption {
  id        String        @id @default(uuid())
  groupId   String        @map("group_id")
  name      String
  price     Int           @default(0)
  sortOrder Int           @default(0) @map("sort_order")
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("modifier_options")
}

model OrderItem {
  id                  String @id @default(uuid())
  orderId             String @map("order_id")
  productId           String @map("product_id")
  productName         String @map("product_name")
  quantity            Int
  unitPrice           Int    @map("unit_price")
  modifiers           String
  specialInstructions String @default("") @map("special_instructions")
  itemTotal           Int    @map("item_total")
  order               Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
