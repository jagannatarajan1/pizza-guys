generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(uuid())
  name                 String    @default("")
  email                String    @unique
  phone                String    @default("")
  passwordHash         String    @map("password_hash")
  role                 String    @default("user")
  createdAt            DateTime  @default(now()) @map("created_at")
  failedLogins         Int       @default(0) @map("failed_logins")
  lockedUntil          DateTime? @map("locked_until")
  twoFactorBackup      String    @default("[]") @map("two_factor_backup")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret")
  passwordResetExpires DateTime? @map("password_reset_expires")
  passwordResetToken   String?   @map("password_reset_token")
  // Bumped on every successful password change/reset. Embedded in each JWT at
  // sign time — a request is only trusted if its token's value still matches
  // this column, which is what lets us kill every other session on demand
  // even though auth itself is a stateless JWT with no server-side session store.
  tokenVersion         Int       @default(0) @map("token_version")
  passwordChangedAt    DateTime? @map("password_changed_at")
  pendingEmail         String?   @map("pending_email")
  // OTP-based email-change verification (replaces the old emailed-link token).
  pendingEmailOtpHash     String?   @map("pending_email_otp_hash")
  pendingEmailOtpExpires  DateTime? @map("pending_email_otp_expires")
  pendingEmailAttempts    Int       @default(0) @map("pending_email_attempts")
  // Passwordless "email me a code" sign-in. Same shape as the email-change OTP
  // above: only an HMAC of the code is ever stored, it expires quickly, and a
  // per-code attempt counter burns it after too many wrong guesses. Issuing a
  // new code overwrites the hash, which is what invalidates the previous one.
  // loginOtpScope records which door the code was issued for ("user" or
  // "admin") so a code obtained from the customer form can never be redeemed
  // at the staff form, and vice versa.
  loginOtpHash            String?   @map("login_otp_hash")
  loginOtpExpires         DateTime? @map("login_otp_expires")
  loginOtpAttempts        Int       @default(0) @map("login_otp_attempts")
  loginOtpScope           String?   @map("login_otp_scope")
  addresses            Address[]
  orders               Order[]
  passwordHistory      PasswordHistory[]
  auditLogs            AuditLog[]

  // Supports the periodic sweep that wipes codes which have already expired,
  // so stale hashes don't linger on rows indefinitely.
  @@index([loginOtpExpires])
  @@map("users")
}

// Last few password hashes for this user, so a "new" password can be checked
// against recently-used ones and not just the single current password.
model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

// Security-relevant account events (password/email changes, failures) kept
// for auditing — independent of the live User row so history survives even
// if the account is later deleted.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String?
  action    String
  detail    String   @default("")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model PendingRegistration {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String   @map("password_hash")
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String   @default("Home")
  line1     String   @default("")
  line2     String   @default("")
  city      String   @default("")
  postcode  String   @default("")
  notes     String   @default("")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  userId          String?     @map("user_id")
  status          String      @default("pending")
  orderType       String      @map("order_type")
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  customerPhone   String      @map("customer_phone")
  deliveryAddress String?     @map("delivery_address")
  subtotal        Int
  deliveryFee     Int         @default(0) @map("delivery_fee")
  discount        Int         @default(0)
  total           Int
  paymentIntentId String?     @map("payment_intent_id")
  paymentMethod   String      @default("card") @map("payment_method")
  scheduledTime   DateTime?   @map("scheduled_time")
  // Set when staff accept the order and choose a preparation time. Together
  // these are the only inputs the auto-progress timer needs — every tick
  // re-derives the correct status from them, so a server restart can never
  // strand an order mid-preparation. Null on orders placed before this
  // feature shipped, which the timer skips and the UI falls back to manual.
  acceptedAt      DateTime?   @map("accepted_at")
  prepMinutes     Int?        @map("prep_minutes")
  createdAt       DateTime    @default(now()) @map("created_at")
  items           OrderItem[]
  user            User?       @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("orders")
}

model Category {
  id      String  @id
  name    String
  slug    String  @unique
  icon    String  @default("🍽️")
  visible Boolean @default(true)
  order   Int     @default(0)
  image   String  @default("")

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  price       Int
  image       String   @default("")
  category    String
  popular     Boolean  @default(false)
  available   Boolean  @default(true)
  modifiers   String   @default("[]")
  allergens   String   @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model SiteConfig {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

model DeliveryZone {
  id          String  @id @default(uuid())
  postcode    String  @unique
  minOrder    Int     @default(1000) @map("min_order")
  deliveryFee Int     @default(199) @map("delivery_fee")
  enabled     Boolean @default(true)

  @@map("delivery_zones")
}

// Distance bands from the restaurant (in miles), replacing postcode-prefix
// zones above with actual straight-line distance — see DeliveryBand usage in
// src/lib/delivery.ts. Old DeliveryZone table is left in place but unused.
model DeliveryBand {
  id          String @id @default(uuid())
  fromMiles   Float  @map("from_miles")
  toMiles     Float  @map("to_miles")
  minOrder    Int    @map("min_order")
  deliveryFee Int    @map("delivery_fee")
  sortOrder   Int    @default(0) @map("sort_order")

  @@map("delivery_bands")
}

// Admin-configurable preparation-time buttons shown when staff accept an
// order. Seeded with sensible defaults on first read so the picker is never
// empty on a fresh install.
model PrepTimePreset {
  id        String   @id @default(uuid())
  minutes   Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("prep_time_presets")
}

// Caches postcode -> lat/lng lookups from postcodes.io so repeat customers
// (very common — UK postcodes cover a handful of houses each) don't cost a
// fresh external API call every time.
model PostcodeGeocode {
  postcode  String   @id
  latitude  Float
  longitude Float
  cachedAt  DateTime @default(now()) @map("cached_at")

  @@map("postcode_geocode_cache")
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String
  value       Int       @default(0)
  minOrder    Int       @default(0) @map("min_order")
  description String    @default("")
  active      Boolean   @default(true)
  usageLimit  Int?      @map("usage_limit")
  usageCount  Int       @default(0) @map("usage_count")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  // Empty orderTypes means "valid for both delivery and collection" — avoids
  // needing a non-empty array default and keeps every existing coupon
  // unrestricted until an admin explicitly narrows it.
  orderTypes   String[] @default([]) @map("order_types")
  combinable   Boolean  @default(false)
  combinesWith String[] @default([]) @map("combines_with")
  // Empty means "applies to every item in the cart" — category slugs (e.g.
  // "pizza", "desserts") that this coupon's discount is restricted to.
  applicableCategories String[] @default([]) @map("applicable_categories")

  @@map("coupons")
}

model ModifierGroup {
  id          String           @id @default(uuid())
  name        String
  // Sub-heading shown under the step title in the picker.
  description String           @default("")
  required    Boolean          @default(false)
  multiSelect Boolean          @default(false) @map("multi_select")
  min         Int              @default(0)
  max         Int              @default(1)
  // How many times a single option may be picked (two of the same salad).
  maxPerOption Int             @default(1) @map("max_per_option")
  sortOrder   Int              @default(0) @map("sort_order")
  // Only offer this step when the named group has one of these options chosen
  // — how "pick your meal drink" stays hidden until a meal is added.
  dependsOnGroup   String?     @map("depends_on_group")
  dependsOnOptions String      @default("[]") @map("depends_on_options")
  // Group whose choice drives this group's per-option price overrides.
  priceDependsOn   String?     @map("price_depends_on")
  options     ModifierOption[]

  @@map("modifier_groups")
}

model ModifierOption {
  id        String        @id @default(uuid())
  groupId   String        @map("group_id")
  name      String
  price     Int           @default(0)
  // Short badge — "Spicy", "Contains Fish" — kept out of the name so it never
  // ends up baked into the text printed on a kitchen ticket.
  tag       String        @default("")
  // JSON map of driving-option id to price in pence, used when the owning
  // group sets priceDependsOn.
  priceBy   String        @default("{}") @map("price_by")
  sortOrder Int           @default(0) @map("sort_order")
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("modifier_options")
  @@index([groupId])
}

model OrderItem {
  id                  String @id @default(uuid())
  orderId             String @map("order_id")
  productId           String @map("product_id")
  productName         String @map("product_name")
  quantity            Int
  unitPrice           Int    @map("unit_price")
  modifiers           String
  specialInstructions String @default("") @map("special_instructions")
  itemTotal           Int    @map("item_total")
  order               Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
